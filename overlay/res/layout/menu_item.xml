<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="62dp"
    android:padding="5dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/stone_item">
    <com.tbd.forkfront.NH_TextView android:id="@+id/item_acc"
        android:layout_width="28dp"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:textColor="#DCD4AB"
        android:gravity="center"
        android:text="a"/>
    <ImageView android:id="@+id/item_tile"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:minWidth="42dp"
        android:minHeight="42dp"
        android:layout_marginEnd="8dp"
        android:scaleType="fitCenter"/>
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:orientation="vertical">
        <com.tbd.forkfront.NH_TextView android:id="@+id/item_text"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="15sp"
            android:textColor="#F6EFDD"/>
        <com.tbd.forkfront.NH_TextView android:id="@+id/item_sub"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="#B7CAAC"/>
    </LinearLayout>
    <com.tbd.forkfront.NH_TextView android:id="@+id/item_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="6dp"
        android:textSize="13sp"
        android:textColor="#F3E7BF"/>
    <CheckBox android:id="@+id/item_check"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:focusable="false"
        android:clickable="false"
        android:buttonTint="#C9BA7D"/>
</LinearLayout>