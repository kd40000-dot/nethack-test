<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
  <item android:state_pressed="true">
    <shape><solid android:color="#677363"/><stroke android:width="1dp" android:color="#CABD83"/><corners android:radius="2dp"/></shape>
  </item>
  <item android:state_checked="true">
    <shape><solid android:color="#545C4A"/><stroke android:width="1dp" android:color="#A4A373"/><corners android:radius="2dp"/></shape>
  </item>
  <item>
    <shape><solid android:color="#39413D"/><stroke android:width="1dp" android:color="#6B7058"/><corners android:radius="2dp"/></shape>
  </item>
</selector>